# Program Sistem Penilaian Mahasiswa

# Meminta input jumlah mahasiswa
jumlah_mhs = int(input("Masukkan jumlah mahasiswa: "))

total_nilai = 0

# Perulangan (for) untuk memasukkan nilai setiap mahasiswa
for i in range(1, jumlah_mhs + 1):
    nilai = float(input(f"masukan nilai mahasiswa {i}: "))
    total_nilai += nilai
    
    # Penggunaan percabangan (if) untuk menentukan status kelulusan
    if nilai >= 70:
        print(f"Status Mahasiswa {i}: Lulus")
    else:
        print(f"Status Mahasiswa {i}: Perbaikan")

# Menghitung dan menampilkan nilai rata-rata
rata_rata = total_nilai / jumlah_mhs
print("-" * 30)
print(f"Nilai rata-rata: {rata_rata}")